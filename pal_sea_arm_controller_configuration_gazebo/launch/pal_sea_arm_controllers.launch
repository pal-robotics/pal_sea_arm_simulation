<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="public_sim"        default="false"/>
    <arg name="end_effector"/>
    <arg name="ft_sensor"/>
    <arg name="advanced_grasping" default="false"/> <!-- Requires extra software from PAL Robotics -->


    <include file="$(find pal_sea_arm_controller_configuration_gazebo)/launch/default_controllers.launch"/>

    <group if="$(eval ft_sensor == 'rokubi')">
        <include file="$(find pal_sea_arm_controller_configuration)/launch/force_torque_controller.launch"/>
    </group>

    <group if="$(eval end_effector == 'pal-pro-gripper')">
        <rosparam command="load" file="$(find pal_pro_gripper_controller_configuration)/config/joint_trajectory_controllers.yaml" />
        <include file="$(find pal_pro_gripper_controller_configuration_gazebo)/launch/gripper_controller.launch"/>
    </group>

    <!-- Play motion -->
    <include file="$(find pal_sea_arm_bringup)/launch/play_motion.launch">
      <arg name="end_effector"  value="$(arg end_effector)"/>
      <arg name="ft_sensor"  value="$(arg ft_sensor)"/>
    </include>

    <!-- Motion planning -->
    <include file="$(find pal_sea_arm_moveit_config)/launch/move_group.launch">
      <arg name="end_effector" value="$(arg end_effector)"/>
      <arg name="ft_sensor" value="$(arg ft_sensor)"/>
      <arg name="capabilities" value="move_group/CapabilityLoader" unless="$(arg public_sim)"/>
      <arg name="moveit_sensor_manager" value="advanced_grasping" if="$(arg advanced_grasping)"/>
    </include>
</launch>
