<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="end_effector"/>
  <arg name="ft_sensor"/>
  <arg name="model_name" default="pal_sea_arm"/>
  <arg name="gzpose" default="-x 0 -y 0 -z 0.0 -R 0.0 -P 0.0 -Y 0.0"/>

  <arg name="file_suffix" value="$(eval ((end_effector if end_effector else 'no-ee') + ('_' +  ft_sensor if ft_sensor else '')))"/>  

  <arg name="ee_suffix" value="$(eval (end_effector if end_effector else 'no-ee'))"/>

 <rosparam ns="pal_robot_info" subst_value="true">
    type: "pal_sea_arm"
    end_effector: $(arg ee_suffix)
    ft_sensor: $(arg ft_sensor)
  </rosparam>

  <!-- PID gains -->
  <rosparam command="load" file="$(find pal_sea_arm_gazebo)/config/pids.yaml"/>
  <!-- Override Gazebo Joint PID gain for arm_7_joint in case of no end-effector -->
  <param name="gains/arm_7_joint/p" value="10" if="$(eval ee_suffix == 'no-ee')"/>

  <rosparam command="load" file="$(find pal_sea_arm_gazebo)/config/hardware_gazebo/pal_sea_arm_pal_hardware_gazebo_$(arg file_suffix).yaml"/>


  <!-- Robot model -->
  <include file="$(find pal_sea_arm_description)/robots/upload.launch">
    <arg name="end_effector" value="$(arg end_effector)"/>
    <arg name="ft_sensor" value="$(arg ft_sensor)"/>
    <arg name="arm_model" default="pal-sea-arm-standalone"/>
  </include>

  <!-- Spawn robot in Gazebo -->
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_model"
    args="-urdf -param robot_description $(arg gzpose) -model $(arg model_name)" />

</launch>
