<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <!-- Parameters -->
  <arg name="world"  default="empty"/>  <!-- empty, ... (see ../worlds) -->
  <arg name="gzpose" default="-x 0.0 -y 0.0 -z 1.0 -R 0.0 -P 0.0 -Y 0.0"/>
  <arg name="end_effector"  default="pal-pro-gripper"/>
  <arg name="ft_sensor"  default="false"/>
  <arg name="gui" default="true"/>
  <arg name="debug" default="false"/>
  <arg name="recording" default="false"/>
  <arg name="extra_gazebo_args" default=""/>
  
  <!-- start up world -->
  <include file="$(find pal_gazebo_worlds)/launch/pal_gazebo.launch">
    <arg name="world" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="recording" value="$(arg recording)"/>
    <arg name="extra_gz_model_path" value="$(find pal_sea_arm_gazebo)/models"/>
    <arg name="extra_gz_resource_path" value="$(find pal_sea_arm_gazebo)"/>
    <arg name="extra_gazebo_args" value="$(arg extra_gazebo_args)"/>
  </include>

  <!-- spawn robot in simulation -->
  <include file="$(find pal_sea_arm_gazebo)/launch/pal_sea_arm_spawn.launch">
    <arg name="gzpose" value="$(arg gzpose)"/>
    <arg name="end_effector" value="$(arg end_effector)"/>
    <arg name="ft_sensor" value="$(arg ft_sensor)"/>
  </include>

  <!-- bring up robot -->
  <include file="$(find pal_sea_arm_gazebo)/launch/pal_sea_arm_simulation_bringup.launch">
    <arg name="end_effector" value="$(arg end_effector)"/>
    <arg name="ft_sensor" value="$(arg ft_sensor)"/>
  </include>

</launch>
